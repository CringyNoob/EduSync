# =============================================
# EDUSYNC PROJECT ENVIRONMENT CONFIGURATION
# =============================================
# This file contains example environment variables for the entire project.
# Copy this file to .env and fill in your actual values.
# Each service also has its own .env.example in its directory.

# --- AIVEN DATABASE CONFIGURATION ---
# These credentials are shared across all services
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=16231
DB_USER=avnadmin
DB_PASSWORD=your-database-password-here

# Database names per service:
# auth_db     - Auth Service (Port 3001)
# market_db   - Marketplace Service (Port 3002)
# rent_db     - RentHub Service (Port 3003)
# newsbox_db  - NewsBox Service (Port 3004)
# chat_db     - Chat Service (Port 3006)

# --- JWT CONFIGURATION ---
# CRITICAL: All services must use the same JWT_SECRET
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# --- SERVICE PORTS ---
# Auth Service:        3001
# Marketplace Service: 3002
# RentHub Service:     3003
# NewsBox Service:     3004
# Notices Service:     3005 (no database, scrapes UIU website)
# Chat Service:        3006
# Gateway:             8000
# Client:              5173

# --- EMAIL CONFIGURATION (for OTP) ---
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here

# --- PAYMENT CONFIGURATION (SSLCommerz Sandbox) ---
SSLCOMMERZ_STORE_ID=your-store-id
SSLCOMMERZ_STORE_PASSWORD=your-store-password
